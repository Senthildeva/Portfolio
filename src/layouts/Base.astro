---
// Page shell: <head>, navigation, footer, the Say Hello panel and shared scripts.
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SayHello from "../components/SayHello.astro";
import Splash from "../components/Splash.astro";
import { SITE, type NavKey } from "../site";

interface Props {
  title: string;
  description: string;
  active?: NavKey;
  /** Landing page only: play the intro. */
  splash?: boolean;
  /** Keep this page out of search results (404). */
  noindex?: boolean;
}
const { title, description, active = "", splash = false, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = new URL(path || "/", SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/proxima-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/avenir-roman.woff2" as="font" type="font/woff2" crossorigin />
    {
      splash && (
        <script is:inline>
          try{if(sessionStorage.getItem("sd-splash")||matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("no-splash")}catch(e){}
        </script>
      )
    }
    {splash && <noscript><style is:inline>.splash{display:none}</style></noscript>}
  </head>
  <body>
    {splash && <Splash />}
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav active={active} />
    <slot />
    <Footer />
    <SayHello />
    <script>
      // Fade content in as it scrolls into view (only for content below the first screen).
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce && "IntersectionObserver" in window) {
        const fold = window.innerHeight * 0.9;
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (!en.isIntersecting) continue;
              en.target.classList.add("revealed");
              en.target.classList.remove("will-reveal");
              io.unobserve(en.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          if (el.getBoundingClientRect().top > fold) {
            el.classList.add("will-reveal");
            io.observe(el);
          }
        });
      }
    </script>
  </body>
</html>
