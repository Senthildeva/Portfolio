---
// Page shell: <head>, the intro, navigation, footer, the Say Hello panel and shared scripts
// (heading letter pop, reveal-on-scroll for every page, and the scroll-driven typewriter).
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SayHello from "../components/SayHello.astro";
import Splash from "../components/Splash.astro";
import { SITE, type NavKey } from "../site";

interface Props {
  title: string;
  description: string;
  active?: NavKey;
  /** Keep this page out of search results (404). */
  noindex?: boolean;
}
const { title, description, active = "", noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = new URL(path || "/", SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/proxima-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/avenir-roman.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Before the first paint: the intro plays when someone arrives at the site or reloads a page
      // (not when clicking from page to page), and content that animates in starts hidden.
      (function () {
        var html = document.documentElement;
        var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        var intro = false;
        try {
          var nav = performance.getEntriesByType("navigation")[0];
          var type = nav ? nav.type : "navigate";
          var fromHere = !!document.referrer && new URL(document.referrer).origin === location.origin;
          intro = !reduce && (type === "reload" || (type === "navigate" && !fromHere));
        } catch (e) {}
        if (!intro) html.classList.add("no-splash");
        if (!reduce) html.classList.add("reveal-on");
      })();
    </script>
    <noscript><style is:inline>.splash{display:none}</style></noscript>
  </head>
  <body>
    <Splash />
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav active={active} />
    <slot />
    <Footer />
    <SayHello />
    <script>
      const html = document.documentElement;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const motion = !reduce && "IntersectionObserver" in window;

      // ---------- Shared: split text into words and letters, keeping its inline markup ----------
      type Segmenter = new (locale?: string, options?: { granularity: string }) => { segment(s: string): Iterable<{ segment: string }> };
      const Seg = (Intl as unknown as { Segmenter?: Segmenter }).Segmenter;
      const seg = Seg ? new Seg(undefined, { granularity: "grapheme" }) : null;
      // Letters as people see them: an emoji with a skin tone stays one letter.
      const letters = (s: string) => (seg ? Array.from(seg.segment(s), (x) => x.segment) : Array.from(s));
      /** Wraps each word of `root` in a no-wrap element and each letter in its own element.
       *  Returns the letters in reading order, with null for each run of spaces. */
      const splitText = (root: Element, word: () => HTMLElement, letter: () => HTMLElement) => {
        const out: (HTMLElement | null)[] = [];
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        const texts: Text[] = [];
        while (walker.nextNode()) texts.push(walker.currentNode as Text);
        for (const t of texts) {
          const frag = document.createDocumentFragment();
          for (const part of (t.textContent ?? "").split(/([ \t\n\r\f]+)/)) {
            if (!part) continue;
            if (/^[ \t\n\r\f]+$/.test(part)) {
              frag.append(part);
              out.push(null);
              continue;
            }
            const w = word();
            for (const ch of letters(part)) {
              const c = letter();
              c.textContent = ch;
              w.append(c);
              out.push(c);
            }
            frag.append(w);
          }
          t.replaceWith(frag);
        }
        return out;
      };
      /** Gives screen readers an untouched copy of the element's content and returns a visible copy to animate. */
      const twin = (el: HTMLElement, tag: string) => {
        const copy = document.createElement(tag);
        copy.className = "sr-only";
        copy.innerHTML = el.innerHTML;
        const shown = document.createElement(tag);
        shown.setAttribute("aria-hidden", "true");
        shown.innerHTML = el.innerHTML;
        el.replaceChildren(copy, shown);
        return shown;
      };

      // ---------- Headings: letters pop in one after another (after bitcandy.studio) ----------
      // Each letter fades in while growing to 125%, then settles. Letters start 45ms apart; long
      // headings run the wave faster so it never takes much over 2s. Plays once, when the heading's
      // top reaches 85% of the screen. Letters are custom elements so CSS aimed at a heading's spans skips them.
      const waves = motion ? [...document.querySelectorAll<HTMLElement>("main h1, main h2, .footer h2")].filter((h) => h.textContent?.trim() && !h.closest(".sr-only, [data-typewriter]")) : [];
      const grads: { el: HTMLElement; bg: string }[] = [];
      for (const h of waves) {
        const shown = twin(h, "wp-t");
        const pieces = splitText(shown, () => document.createElement("wp-w"), () => document.createElement("wp-c"));
        pieces.forEach((c, i) => c?.style.setProperty("--i", String(i)));
        const step = Math.min(45, 1600 / Math.max(1, pieces.length - 1));
        h.style.setProperty("--step", `${step.toFixed(1)}ms`);
        h.dataset.waveMs = String(Math.round((pieces.length - 1) * step + 360));
        // Gradient text clips its background to its letters, which stops working once letters move on
        // their own, so each letter gets its own slice of the gradient instead.
        for (const el of shown.querySelectorAll<HTMLElement>("*")) {
          if (el.localName === "wp-w" || el.localName === "wp-c") continue;
          const cs = getComputedStyle(el);
          if (cs.backgroundClip !== "text" && cs.getPropertyValue("-webkit-background-clip") !== "text") continue;
          grads.push({ el, bg: cs.backgroundImage });
          el.style.backgroundImage = "none";
          el.querySelectorAll("wp-c").forEach((c) => c.setAttribute("data-g", ""));
        }
        h.classList.add("wp-ready");
      }
      // Lays each gradient across its letters as it was across the text, line after line.
      const paintGrads = () => {
        for (const g of grads) {
          const lines = [...g.el.getClientRects()];
          if (!lines.length) continue;
          const total = lines.reduce((s, r) => s + r.width, 0);
          for (const w of g.el.querySelectorAll<HTMLElement>("wp-w")) {
            const r = w.getBoundingClientRect();
            const mid = r.top + r.height / 2;
            const k = Math.max(0, lines.findIndex((l) => mid >= l.top - 1 && mid <= l.bottom + 1));
            let x = lines.slice(0, k).reduce((s, l) => s + l.width, 0) + r.left - lines[k].left;
            for (const c of w.children as HTMLCollectionOf<HTMLElement>) {
              c.style.backgroundImage = g.bg;
              c.style.backgroundSize = `${total}px 100%`;
              c.style.backgroundPosition = `${-x}px 0`;
              x += c.offsetWidth;
            }
          }
        }
      };
      if (grads.length) {
        paintGrads();
        document.fonts?.ready.then(paintGrads);
        let t = 0;
        addEventListener("resize", () => {
          clearTimeout(t);
          t = window.setTimeout(paintGrads, 150);
        });
      }

      // ---------- Reveal: blocks and images fade up as they come into view, on every page load ----------
      // Targets are the content blocks of each page; when one target contains others, the inner ones animate.
      const TARGETS = [
        "main > section > *", "main > div > *", "main > nav", "main > section > .wrap > *", "main .hero > *",
        "main .cs-sec > *", "main .section-head > *", "main .cards > *", "main .stack-xl > *", "main .statement-body > *",
        "main .tl-item", "main .xp-grid > *", "main .stats > *", "main .brand-grid > *", "main .quotes > *",
        ".footer .f-cta", ".footer .f-status", ".footer .f-note", ".footer .f-logo", ".footer .f-bottom",
      ].join(",");
      const SKIP = "script, style, template, link, meta, noscript, [data-typewriter], [data-typewriter] *, .ticker-track *, .sr-only, .ac-list";
      const MEDIA = ".hero-media, .cs-cover, .cs-img, .cs-dfig, .cs-board-flat, .ac, .card, .gallery, figure";

      if (motion) {
        const found = new Set<Element>(document.querySelectorAll(TARGETS));
        const isWave = (el: Element) => waves.includes(el as HTMLElement);
        const holdsWave = (el: Element) => waves.some((h) => el.contains(h));
        let targets = [...found].filter((el) => !el.matches(SKIP) && !isWave(el) && ![...found].some((o) => o !== el && el.contains(o)));
        // Headings pop in place, so a block that holds one animates its other parts instead.
        for (let pass = 0; pass < 6 && targets.some(holdsWave); pass++)
          targets = targets.flatMap((el) => (holdsWave(el) ? [...el.children].filter((c) => !c.matches(SKIP) && !isWave(c)) : [el]));
        for (const el of targets) {
          el.classList.add("will-reveal");
          if (el.matches(MEDIA)) el.classList.add("rv-media");
        }
        html.classList.replace("reveal-on", "reveal-ready");

        let started = false;
        const start = () => {
          if (started) return;
          started = true;
          const io = new IntersectionObserver(
            (entries) => {
              // Things that come into view together follow one another.
              const shown = entries.filter((en) => en.isIntersecting).map((en) => en.target as HTMLElement);
              shown.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top || a.getBoundingClientRect().left - b.getBoundingClientRect().left);
              shown.forEach((el, i) => {
                el.style.transitionDelay = `${Math.min(i, 6) * 90}ms`;
                el.classList.add("revealed");
                el.classList.remove("will-reveal");
                io.unobserve(el);
                el.addEventListener("transitionend", () => (el.style.transitionDelay = ""), { once: true });
              });
            },
            { rootMargin: "0px 0px -6% 0px" },
          );
          targets.forEach((el) => io.observe(el));
          const waveIo = new IntersectionObserver(
            (entries) => {
              for (const en of entries) {
                if (!en.isIntersecting) continue;
                const h = en.target as HTMLElement;
                waveIo.unobserve(h);
                h.classList.add("wp-on");
                setTimeout(() => h.classList.add("wp-done"), Number(h.dataset.waveMs) + 120);
              }
            },
            { rootMargin: "0px 0px -15% 0px" },
          );
          waves.forEach((h) => waveIo.observe(h));
        };
        // Wait for the intro to finish so the first screen animates in as it clears.
        if (document.getElementById("splash") && !html.classList.contains("no-splash")) {
          addEventListener("splash:done", start, { once: true });
          setTimeout(start, 9500);
        } else start();
      } else html.classList.remove("reveal-on");

      // ---------- Typewriter: text in [data-typewriter] types itself as the page scrolls ----------
      // Untyped letters wait at half strength and turn solid as they are typed. Screen readers get an
      // untouched copy; people who prefer reduced motion see the text as is.
      const writers = [...document.querySelectorAll<HTMLElement>("[data-typewriter]")];
      if (!reduce && writers.length) {
        const items = writers.map((root) => {
          const chars: HTMLElement[] = [];
          for (const p of root.matches("p") ? [root] : [...root.querySelectorAll<HTMLElement>("p")]) {
            const shown = twin(p, "span");
            const span = (cls: string) => () => {
              const s = document.createElement("span");
              s.className = cls;
              return s;
            };
            for (const c of splitText(shown, span("tw-w"), span("tw-c"))) if (c) chars.push(c);
          }
          root.classList.add("tw-ready");
          return { root, chars, n: 0 };
        });
        const update = () => {
          const vh = innerHeight;
          for (const it of items) {
            const r = it.root.getBoundingClientRect();
            // Typing starts when the text's top passes 85% of the screen and ends when its bottom passes 45%.
            const from = vh * 0.85, to = vh * 0.45;
            const p = Math.min(1, Math.max(0, (from - r.top) / (from - to + r.height)));
            const n = Math.round(p * it.chars.length);
            if (n === it.n) continue;
            it.chars[it.n - 1]?.classList.remove("caret");
            for (let i = Math.min(n, it.n); i < Math.max(n, it.n); i++) it.chars[i].classList.toggle("on", i < n);
            if (n > 0 && n < it.chars.length) it.chars[n - 1].classList.add("caret");
            it.n = n;
          }
        };
        let frame = 0;
        const queue = () => {
          if (!frame) frame = requestAnimationFrame(() => ((frame = 0), update()));
        };
        addEventListener("scroll", queue, { passive: true });
        addEventListener("resize", queue);
        update();
      }
    </script>
  </body>
</html>
