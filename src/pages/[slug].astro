---
// Case-study pages: one per published YAML file in src/content/work (cna.yaml → /cna).
import Base from "../layouts/Base.astro";
import "../styles/case-study.css";
import CaseHero from "../components/case-study/CaseHero.astro";
import Stage from "../components/case-study/Stage.astro";
import Block from "../components/case-study/Block.astro";
import Pager from "../components/case-study/Pager.astro";
import { caseStudies, neighbours, type WorkEntry } from "../lib/work";
import { SITE } from "../site";

export async function getStaticPaths() {
  const list = await caseStudies();
  return list.map((entry) => ({ params: { slug: entry.id }, props: { entry, ...neighbours(list, entry.id) } }));
}

interface Props {
  entry: WorkEntry;
  prev?: WorkEntry;
  next?: WorkEntry;
}
const { entry, prev, next } = Astro.props;
const d = entry.data;
---
<Base
  title={d.seo!.title}
  description={d.seo!.description}
  active="work"
  type="article"
  noindex={d.nda}
  image={d.seo!.image}
  imageAlt={d.seo!.imageAlt}
  schema={[
    {
      "@type": "CreativeWork",
      "@id": new URL(`/${entry.id}#case-study`, SITE.url).href,
      name: d.seo!.title.replace(/ · Senthil Devaraj$/, ""),
      headline: d.hero!.title.replace(/<[^>]+>/g, ""),
      description: d.seo!.description,
      url: new URL(`/${entry.id}`, SITE.url).href,
      ...(d.seo!.image ? { image: new URL(d.seo!.image, SITE.url).href } : {}),
      author: { "@id": new URL("/#person", SITE.url).href },
      inLanguage: "en",
    },
  ]}
>
  <main id="main" class={`cs theme-${d.theme}`}>
    <CaseHero {...d.hero!} />
    <Stage {...d.stage!} />
    {
      d.sections!.map((s) =>
        "full" in s ? (
          <div><Block block={s.full} /></div>
        ) : s.band ? (
          <section class="cs-band"><div class="wrap cs-sec">{s.blocks.map((b) => <Block block={b} />)}</div></section>
        ) : (
          <section class:list={["wrap cs-sec", s.cls]} id={s.id}>{s.blocks.map((b) => <Block block={b} />)}</section>
        ),
      )
    }
    <Pager prev={prev} next={next} />
  </main>
</Base>
