---
// The footer's LinkedIn and call icons, from Senthil's Figma exports (32×32, #101010, 2px corners).
// The LinkedIn mark is his exported logo picture, used as a mask so the whole icon can take the
// hover colour; its position matches the export (a 25×26 tile at 4,3 holding the slightly larger picture).
// The white behind the letters stops 1 unit short of the tile's edge, so no light seam shows around it.
interface Props {
  name: "linkedin" | "call";
}
const { name } = Astro.props;
const LI_MASK = "data:image/png;base64,";
---
{
  name === "linkedin" ? (
    <svg class="fi" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
      <defs>
        <clipPath id="fi-li-tile"><rect x="4" y="3" width="25" height="26" rx="2" /></clipPath>
        <mask id="fi-li-mark" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
          <image href={LI_MASK} x="3" y="2.9394" width="28.1667" height="26.1212" preserveAspectRatio="none" />
        </mask>
      </defs>
      <rect class="fi-frame" width="32" height="32" rx="2" />
      <g clip-path="url(#fi-li-tile)">
        <rect x="5" y="4" width="23" height="24" fill="#fff" />
        <rect class="fi-mark" width="32" height="32" mask="url(#fi-li-mark)" />
      </g>
    </svg>
  ) : (
    <svg class="fi" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
      <rect class="fi-frame" width="32" height="32" rx="2" />
      <path d="M17.527 19.807C17.6991 19.886 17.893 19.9041 18.0767 19.8582C18.2605 19.8123 18.4231 19.7052 18.5378 19.5545L18.8337 19.167C18.9889 18.96 19.1902 18.792 19.4216 18.6763C19.6531 18.5606 19.9083 18.5003 20.167 18.5003H22.667C23.109 18.5003 23.5329 18.6759 23.8455 18.9885C24.1581 19.301 24.3337 19.725 24.3337 20.167V22.667C24.3337 23.109 24.1581 23.5329 23.8455 23.8455C23.5329 24.1581 23.109 24.3337 22.667 24.3337C18.6887 24.3337 14.8734 22.7533 12.0604 19.9403C9.24734 17.1272 7.66699 13.3119 7.66699 9.33366C7.66699 8.89163 7.84259 8.46771 8.15515 8.15515C8.46771 7.84259 8.89163 7.66699 9.33366 7.66699H11.8337C12.2757 7.66699 12.6996 7.84259 13.0122 8.15515C13.3247 8.46771 13.5003 8.89163 13.5003 9.33366V11.8337C13.5003 12.0924 13.4401 12.3476 13.3244 12.579C13.2087 12.8104 13.0407 13.0117 12.8337 13.167L12.4437 13.4595C12.2907 13.5763 12.1828 13.7425 12.1385 13.9298C12.0941 14.1171 12.116 14.314 12.2003 14.487C13.3392 16.8002 15.2123 18.671 17.527 19.807Z" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
