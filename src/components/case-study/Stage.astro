---
// Cover image (or cover video, with the image as its poster) over the dark band,
// then the project facts and the one-paragraph intro.
import Img from "../Img.astro";
import Video from "./Video.astro";
interface Props {
  img: string;
  video?: string;
  alt?: string;
  meta: Record<string, string>;
  intro: string;
}
const { img, video, alt = "", meta, intro } = Astro.props;
const facts = Object.entries(meta);
---
<section class="cs-stage" aria-label="Project overview">
  <div class="wrap">
    <div class="cs-cover">
      {video ? <Video video={video} poster={img} ratio="1312/700" alt={alt} label="Cover video" /> : <Img id={img} w={1312} h={700} alt={alt} eager label="Cover image" />}
    </div>
    <dl class:list={["cs-meta", { six: facts.length > 4 }]}>{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    <p class="cs-intro" set:html={intro} />
  </div>
</section>
