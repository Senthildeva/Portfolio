---
// Outgrow — UI components board (Figma 13764:3827), rebuilt as live HTML around the exported artwork.
// Text uses the site's fonts (Figma uses Montserrat / Poppins, the app's typefaces).
import Img from "../../Img.astro";

const chipsA = ["All", "Fruits", "Vegetables", "Pulses", "Cereals"];
const chipsB = ["Spices", "Natural Pesticides", "Biological Treatment", "Chemical Treatment"];
---
<div class="ogb" role="group" aria-label="Outgrow UI components">
  <div class="ogb-main">
    <div class="ogb-row">
      <div class="ogb-card ogb-title"><p>WAYCOOL LABS AGRITECH PLATFORM</p></div>
      <div class="ogb-card ogb-chips" aria-label="Crop category filter">
        <ul>{chipsA.map((c) => <li class:list={{ on: c === "Fruits" }}>{c}</li>)}</ul>
        <ul>{chipsB.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
    <div class="ogb-row">
      <div class="ogb-card ogb-prices" aria-label="Live mandi price cards">
        <div class="ogb-price-row">
          <div class="pc sm">
            <span class="pc-bg"><Img id="13764:3859" w={102} h={122} alt="" optional /></span>
            <span class="pc-icon mango"><Img id="13764:3871" w={30} h={39} alt="" optional /></span>
            <p class="pc-name">Mango Banganapalli</p>
            <p class="pc-price">₹<b>25/Kg</b><span class="pc-arrow"><Img id="13764:3870" w={6} h={8} alt="price falling" optional /></span></p>
            <p class="pc-market">Krishnarajapuram<br />Market</p>
          </div>
          <div class="pc lg">
            <span class="pc-bg"><Img id="13764:3923" w={132} h={157} alt="" optional /></span>
            <span class="pc-icon tomato"><Img id="13764:3928" w={40} h={44} alt="" optional /></span>
            <p class="pc-name">Tomato</p>
            <p class="pc-price">₹<b>45/Kg</b><span class="pc-arrow"><Img id="13764:3938" w={7} h={10} alt="price rising" optional /></span></p>
            <p class="pc-market">Saraki Market</p>
          </div>
          <div class="pc sm">
            <span class="pc-bg"><Img id="13764:3940" w={102} h={122} alt="" optional /></span>
            <span class="pc-icon avocado"><Img id="13764:3947" w={26} h={36} alt="" optional /></span>
            <p class="pc-name">Avocado</p>
            <p class="pc-price">₹<b>45/Kg</b><span class="pc-arrow"><Img id="13764:3974" w={6} h={8} alt="price rising" optional /></span></p>
            <p class="pc-market">Kalasipalayam<br />Market</p>
          </div>
        </div>
        <span class="ogb-dots"><Img id="13764:3975" w={33} h={8} alt="" optional /></span>
      </div>
      <div class="ogb-card ogb-audio">
        <div class="ogb-audio-img"><Img id="13764:3981" w={260} h={140} alt="Wheat field at sunset" label="Field" /></div>
        <p>Agriculture experts discussion on organic fertilizers.</p>
        <div class="ogb-player" aria-label="Audio player, 1:20 of 4:50">
          <span class="ogb-play"><Img id="13764:3984" w={20} h={20} alt="" label="▶" /></span>
          <span class="t">01:20</span>
          <span class="bar"><i></i></span>
          <span class="t">04:50</span>
        </div>
      </div>
    </div>
    <div class="ogb-row">
      <div class="ogb-card ogb-leaf"><Img id="13764:3992" w={245} h={269} alt="A hand photographing a leaf on a phone: “Click only the image of the leaf”" label="Leaf scan" /></div>
      <div class="ogb-card ogb-art"><Img id="13764:3993" w={542} h={300} alt="Illustration of farmers working in a green field" label="Farm illustration" /></div>
    </div>
  </div>
  <div class="ogb-side">
    <div class="ogb-card ogb-person">
      <p class="t">User Personalisation</p>
      <p class="s">Select Crops for Information and protection</p>
      <div class="img"><Img id="13764:4000" w={350} h={473} alt="Crop picker grid: Banana, Apple, Avocado and Broccoli selected, Brinjal, Mango and more" label="Crop picker" /></div>
    </div>
    <div class="ogb-card ogb-protect">
      <div class="txt">
        <p>Crop<br />Protection</p>
        <span class="go"><Img id="13764:4005" w={53} h={52} alt="" label="↗" /></span>
      </div>
      <div class="shield"><Img id="13764:4008" w={199} h={208} alt="Shield with leaves" label="Shield" /></div>
    </div>
  </div>
</div>

<style>
  .ogb { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 421px); gap: 24px; align-items: stretch; }
  .ogb-main, .ogb-side { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .ogb-row { display: flex; gap: 24px; min-width: 0; }
  .ogb-card { border-radius: 16px; overflow: hidden; background: #fff; min-width: 0; position: relative; }
  .ogb-card :global(img) { display: block; }

  /* row 1 */
  .ogb-title { flex: 0 0 320px; height: 300px; background: #fff7dd; display: flex; align-items: flex-start; padding: 0 24px; }
  .ogb-title p { margin-top: 24px; width: 272px; font-family: var(--display); font-weight: 600; font-size: 32px; line-height: 44px; color: #101010; }
  .ogb-chips { flex: 1; min-height: 300px; display: flex; justify-content: space-between; gap: 24px; padding: 24px 40px; box-shadow: 0 0 4px rgba(0, 0, 0, 0.08); }
  .ogb-chips ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .ogb-chips li { border: 1px solid #e9e8e2; border-radius: 4px; padding: 4px 10px; font-family: var(--display); font-weight: 500; font-size: 18px; line-height: 20px; color: #000; white-space: nowrap; }
  .ogb-chips li.on { background: #00651c; border-color: #00651c; color: #fff; }

  /* row 2: mandi price cards */
  .ogb-prices { flex: 0 0 532px; height: 300px; border: 1px solid #f2f2f2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; container-type: inline-size; }
  .ogb-price-row { display: flex; align-items: flex-end; gap: 40px; }
  .pc { position: relative; flex: none; color: #171717; font-family: var(--display); text-align: center; }
  .pc.sm { width: 102px; height: 122px; }
  .pc.lg { width: 132px; height: 157px; }
  .pc > * { position: absolute; left: 0; right: 0; margin: 0; }
  .pc-bg, .pc-bg :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pc-icon { display: flex; justify-content: center; }
  .pc.sm .pc-icon { top: 8px; }
  .pc.lg .pc-icon { top: 17px; }
  .pc-icon.avocado { top: 10px; }
  .pc-name { font-size: 8px; line-height: 10px; }
  .pc.sm .pc-name { top: 54px; }
  .pc.lg .pc-name { top: 69px; font-size: 9.6px; line-height: 12px; }
  .pc-price { display: flex; justify-content: center; align-items: center; gap: 1px; font-size: 9.6px; line-height: 12px; }
  .pc-price b { font-weight: 700; }
  .pc.sm .pc-price { top: 71px; }
  .pc.lg .pc-price { top: 90px; font-size: 11.5px; line-height: 14px; }
  .pc-arrow { display: inline-flex; margin-left: 2px; }
  .pc-market { font-size: 8px; line-height: 11px; }
  .pc.sm .pc-market { top: 92px; }
  .pc.lg .pc-market { top: 115px; font-size: 9.6px; line-height: 12px; }
  .ogb-dots { display: flex; }
  @container (max-width: 470px) { .ogb-price-row { gap: 16px; } }
  @container (max-width: 380px) { .ogb-price-row { transform: scale(0.82); } }

  /* row 2: audio card */
  .ogb-audio { flex: 1; height: 300px; border: 1px solid #f2f2f2; padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .ogb-audio-img { height: 140px; border-radius: 0; overflow: hidden; }
  .ogb-audio-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ogb-audio p { font-family: var(--display); font-size: 16px; line-height: 24px; color: #101010; }
  .ogb-player { display: flex; align-items: center; gap: 8px; font-family: var(--display); font-size: 10px; line-height: 14px; color: #000; }
  .ogb-play { display: flex; }
  .ogb-player .bar { flex: 1; height: 4px; border-radius: 10px; background: #fff; position: relative; }
  .ogb-player .bar i { position: absolute; inset: 0 37.5% 0 0; border-radius: 10px; background: #00651c; }

  /* row 3 */
  .ogb-leaf { flex: 0 0 300px; height: 300px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 8px rgba(0, 0, 0, 0.08); }
  .ogb-art { flex: 1; height: 300px; }
  .ogb-art :global(img), .ogb-art :global(.ph) { width: 100%; height: 100%; object-fit: cover; }

  /* side column */
  .ogb-person { flex: 1; min-height: 624px; background: #f8fffb; border: 1px solid #bad6c6; padding: 40px 31px 36px 30px; display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
  .ogb-person .t { font-family: var(--display); font-weight: 500; font-size: 18px; line-height: 24px; color: #101010; }
  .ogb-person .s { font-family: var(--display); font-weight: 300; font-size: 14px; color: #333; }
  .ogb-person .img { margin-top: 20px; width: min(350px, 100%); }
  .ogb-person .img :global(img) { width: 100%; height: auto; }
  .ogb-protect { height: 300px; background: #fff7dd; display: flex; align-items: center; justify-content: center; gap: 24px; padding: 0 24px; }
  .ogb-protect .txt { height: 208px; display: flex; flex-direction: column; justify-content: space-between; }
  .ogb-protect .txt p { font-family: var(--display); font-weight: 500; font-size: 24px; line-height: 32px; color: #101010; }
  .ogb-protect .shield { height: 208px; aspect-ratio: 173.2 / 181; flex: none; }
  .ogb-protect .shield :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 1100px) {
    .ogb { grid-template-columns: minmax(0, 1fr); }
    .ogb-side { flex-direction: row; }
    .ogb-person { min-height: 0; }
    .ogb-protect { flex: 0 0 421px; height: auto; }
  }
  @media (max-width: 820px) {
    .ogb-row, .ogb-side { flex-direction: column; }
    .ogb-title, .ogb-prices, .ogb-leaf, .ogb-protect { flex: none; }
    .ogb-title { height: auto; padding: 24px; }
    .ogb-title p { margin: 0; font-size: 26px; line-height: 34px; }
    .ogb-chips { padding: 24px; }
    .ogb-prices { width: 100%; }
    .ogb-audio { height: auto; }
    .ogb-leaf { height: 300px; }
    .ogb-art { height: 220px; flex: none; }
    .ogb-protect { height: 300px; }
  }
  @media (max-width: 480px) {
    .ogb-chips { flex-direction: column; gap: 16px; }
    .ogb-chips ul { flex-direction: row; flex-wrap: wrap; gap: 10px; }
    .ogb-chips li { font-size: 16px; }
    .ogb-protect .shield { height: 160px; }
    .ogb-protect .txt { height: 160px; }
  }
</style>
