---
// About hero collage (Figma 14199:9930): Senthil's photo on a dark backdrop with hand-written notes and doodles.
// The photo is now the frame's own fill, so the whole frame is exported as one picture (FLAT). The notes stay
// in the page as text: read out by screen readers, and shown as a list under the picture on phones.
// Without that export, the older layered version is drawn: the photo layer (14199:9951) with live notes on top,
// placed as in the 1312×700 frame and scaled with its width.
import { getImage } from "astro:assets";
import Img from "../Img.astro";
import { figmaAsset } from "../../lib/figma";
// Phones get a tall crop of the same picture framed on Senthil, elbow to elbow. The few letters of
// "A Passionate Experience Designer" that fell inside it were cleared from the dark backdrop; the notes
// show as text under the picture instead, so nothing is printed twice.
import portraitPhone from "../../assets/about/portrait-phone.webp";

const FLAT = "14199:9930";
const flat = Boolean(figmaAsset(FLAT));
const PHONE_W = [450, 675, 900];
const phoneSet = (await Promise.all(PHONE_W.map((width) => getImage({ src: portraitPhone, width, format: "webp", quality: 85 }))))
  .map((img, i) => `${img.src} ${PHONE_W[i]}w`)
  .join(", ");

const ROLES = [
  { name: "Curious one", x: 64, y: 64, lines: ["I ask why,", "Then I ask why again . . ."], lx: 64, ly: 109, lw: 260 },
  { name: "Problem-solver", x: 149, y: 392, lines: ["1st, understand the problem,", "Then build . . ."], lx: 149, ly: 437, lw: 260 },
  { name: "AI enthusiast", x: 988, y: 518, lines: ["Curious about what", "we can build with AI . . ."], lx: 988, ly: 563, lw: 250 },
];
// Doodles exported from Figma: [layer id, x, y, width] in the 1312×700 frame (exports include each layer's rotation).
const DOODLES_BEHIND: [string, number, number, number][] = [
  ["14199:9931", 821.05, 197, 19.94],
  ["14199:9933", 334, 127, 258],
  ["14199:9944", 225, 95, 44],
  ["14199:9947", 1162, 538, 48],
  ["14199:9948", 1062.98, 263, 17.97],
  ["14199:9949", 855, 281, 117.8],
  ["14199:9950", 611, 481, 336.6],
];
const at = (x: number, y: number, w?: number) => `left:calc(${x} * var(--u));top:calc(${y} * var(--u))${w ? `;width:calc(${w} * var(--u))` : ""}`;
---
<div class:list={["ac", { "ac-flat": flat }]}>
  <div class="ac-stage">
    {flat ? (
    <div class="ac-photo">
      <picture>
        <source media="(max-width: 760px)" srcset={phoneSet} sizes="100vw" width="900" height="1400" />
        <Img id={FLAT} w={1312} h={700} alt="Black-and-white portrait of Senthil Devaraj, arms folded" eager />
      </picture>
    </div>
    ) : (
    <div class="ac-in">
      {DOODLES_BEHIND.map(([id, x, y, w]) => <span class="ac-abs" style={at(x, y, w)} aria-hidden="true"><Img id={id} alt="" optional /></span>)}
      {
        ROLES.map((r) => (
          <>
            <p class="ac-role" style={at(r.x, r.y)}>The <b>{r.name}</b></p>
            <p class="ac-note" style={at(r.lx, r.ly, r.lw)}>
              <span>{r.lines[0]}</span>
              <span class="r">{r.lines[1]}</span>
            </p>
          </>
        ))
      }
      <div class="ac-photo"><Img id="14199:9951" w={1312} h={700} alt="Senthil Devaraj, arms folded, smiling" label="Photo of Senthil" eager /></div>
      <p class="ac-head" style={at(913.5, 191)}>A Passionate<br />Experience Designer</p>
      <span class="ac-abs ac-stamp" style={at(1149.6, 58.5, 104.2)} aria-hidden="true"><Img id="14218:10271" alt="" optional /></span>
    </div>
    )}
  </div>
  <div class="ac-list">
    <p class="ac-head-m">A Passionate Experience Designer</p>
    <ul>
      {
        ROLES.map((r) => (
          <li>
            <p class="ac-role-m">The <b>{r.name}</b></p>
            <p class="ac-note-m">{r.lines.join(" ")}</p>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .ac { position: relative; background: #070707; overflow: hidden; }
  .ac-stage {
    position: relative; aspect-ratio: 1312 / 700; container-type: inline-size; overflow: hidden;
    /* The Figma backdrop: a soft light patch behind the left-hand notes, fading to near black. */
    background: radial-gradient(ellipse 34% 52% at 23% 37%, #363636 0%, #2a2a2a 30%, #161616 62%, #0b0b0b 85%), #070707;
  }
  .ac-in { position: absolute; inset: 0; --u: calc(100cqw / 1312); font-family: var(--hand); }
  .ac-abs { position: absolute; display: block; }
  .ac-abs :global(img) { display: block; width: 100%; height: auto; }
  .ac-photo { position: absolute; inset: 0; }
  .ac-photo picture { display: block; width: 100%; height: 100%; }
  .ac-photo :global(img), .ac-photo :global(.ph) { width: 100%; height: 100%; object-fit: cover; }
  .ac-photo :global(.ph) { background: none; color: #555; }
  .ac-role { position: absolute; margin: 0; font-size: calc(36 * var(--u)); line-height: 1.25; color: #555; white-space: nowrap; }
  .ac-role b { color: #fff; font-weight: 700; }
  .ac-note { position: absolute; margin: 0; display: flex; flex-direction: column; gap: calc(4 * var(--u)); font-size: calc(24 * var(--u)); line-height: calc(28 * var(--u)); color: #ddd; }
  .ac-note .r { text-align: right; }
  .ac-head { position: absolute; margin: 0; transform: translateX(-50%); text-align: center; font-weight: 700; font-size: calc(40 * var(--u)); line-height: 1.25; color: #fff; white-space: nowrap; }
  .ac-list { display: none; }
  /* One-picture version on wide screens: the notes are in the picture, so the list is for screen readers only. */
  @media (min-width: 761px) {
    .ac-flat .ac-list { display: block; position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  }
  @media (max-width: 760px) {
    .ac-flat .ac-stage { aspect-ratio: 900 / 1400; background: #070707; }
    .ac-role, .ac-note, .ac-head { display: none; }
    .ac-list { display: block; padding: 8px 20px 28px; font-family: var(--hand); color: #ddd; }
    .ac-head-m { font-weight: 700; font-size: 30px; line-height: 1.2; color: #fff; margin-bottom: 16px; }
    .ac-list ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
    .ac-role-m { font-size: 26px; line-height: 1.1; color: #777; }
    .ac-role-m b { color: #fff; }
    .ac-note-m { font-size: 20px; line-height: 1.3; }
  }
</style>
