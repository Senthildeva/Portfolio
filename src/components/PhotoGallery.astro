---
// Endless photo strip: scrolls on its own and pauses while hovered or focused. For people who prefer
// reduced motion it stands still and can be scrolled sideways. The second copy is hidden from screen readers.
import Img from "./Img.astro";

interface Props {
  name: string;
  /** [Figma layer id, description] */
  photos: [string, string][];
  label: string;
  /** Seconds for one full loop. */
  speed?: number;
}
const { name, photos, label, speed = 48 } = Astro.props;
const sizes = "(min-width: 1430px) 400px, (min-width: 930px) 28vw, 260px";
---
<div class="gallery" data-gallery={name} style={`--speed:${speed}s`} tabindex="0" role="region" aria-label={label}>
  <div class="gallery-track">
    <div class="gallery-group">{photos.map(([id, alt], i) => <figure><Img id={id} w={400} h={500} alt={alt} label={`Photo ${i + 1}`} sizes={sizes} /></figure>)}</div>
    <div class="gallery-group" aria-hidden="true">{photos.map(([id], i) => <figure><Img id={id} w={400} h={500} alt="" label={`Photo ${i + 1}`} sizes={sizes} /></figure>)}</div>
  </div>
</div>
