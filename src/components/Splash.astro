---
// Intro: "hello" (handwritten) → white wipe. It plays whenever someone arrives at the site or reloads a page;
// Base.astro hides it before the first paint when clicking between pages, and for people who prefer reduced
// motion. Esc ends it early. When it clears it fires "splash:done".
import "./Splash.css";
import hello from "../assets/splash/hello-stroke.txt?raw";

// Stroke width of the Lottie line at this size (9.09 in the 1920×1080 Lottie → 4.23 in the 410×64 frame).
const STROKE = 4.23;
---
<div class="splash" id="splash">
  <div class="splash-word splash-hello" aria-hidden="true">
    <svg viewBox="0 0 410 64" width="410" height="64" focusable="false">
      <path d={hello.trim()} pathLength="1" fill="none" stroke="#fff" stroke-width={STROKE} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
  <div class="splash-wipe"></div>
</div>

<script>
  const splash = document.getElementById("splash");
  const done = () => dispatchEvent(new Event("splash:done"));

  if (splash) {
    if (document.documentElement.classList.contains("no-splash")) {
      splash.remove();
      done();
    } else {
      document.body.classList.add("no-scroll");
      const words = splash.querySelectorAll<HTMLElement>(".splash-word");
      // How long the word stays: hello needs time to write itself.
      const hold = [1900];
      let step = 0;
      let timer = 0;
      const finish = () => {
        if (!splash.isConnected || splash.classList.contains("done")) return;
        clearTimeout(timer);
        splash.classList.add("done");
        document.body.classList.remove("no-scroll");
        document.removeEventListener("keydown", onKey);
        done();
        setTimeout(() => splash.remove(), 500);
      };
      const next = () => {
        if (step > 0) words[step - 1].classList.replace("show", "leave");
        if (step < words.length) {
          words[step].classList.add("show");
          timer = window.setTimeout(next, hold[step] ?? 900);
          step++;
        } else {
          splash.classList.add("wipe");
          timer = window.setTimeout(finish, 700);
        }
      };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === "Escape") finish();
      };
      document.addEventListener("keydown", onKey);
      timer = window.setTimeout(next, 200);
    }
  }
</script>
