---
// "Say Hello" side panel with the contact form. Opened by any element with [data-say-hi], or by /#say-hi.
// Messages go to /api/contact (api/contact.js → Resend): Senthil gets the message, the sender gets "Thanks, will catch up soon".
import "./SayHello.css";
import Icon from "./Icon.astro";
import { SITE } from "../site";
---
<div class="hi-scrim" data-close-hi></div>
<aside class="hi-panel" id="say-hi" role="dialog" aria-modal="true" aria-labelledby="hi-title" aria-hidden="true">
  <button class="hi-close" type="button" data-close-hi aria-label="Close"><Icon name="x" /></button>
  <div class="hi-top">
    <div class="hi-head">
      <h2 id="hi-title">Let’s Design <span>incredible work together.</span></h2>
      <p>Let's chat over a virtual tea break.☕️</p>
    </div>
    <form class="form" id="hi-form" novalidate>
      <div class="fields">
        <div class="field"><label for="hi-name">Name*</label><input id="hi-name" name="name" type="text" autocomplete="name" placeholder="Your name" required maxlength="80" /><span class="err" aria-live="polite"></span></div>
        <div class="field-row">
          <div class="field"><label for="hi-phone">Mobile Number*</label><input id="hi-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Eg : 98765 43210" required maxlength="20" /><span class="err" aria-live="polite"></span></div>
          <div class="field"><label for="hi-email">Email ID*</label><input id="hi-email" name="email" type="email" autocomplete="email" placeholder="name@company.com" required maxlength="120" /><span class="err" aria-live="polite"></span></div>
        </div>
        <div class="field"><label for="hi-message">Your Thoughts*</label><textarea id="hi-message" name="message" placeholder="Write your message here..." required maxlength="4000"></textarea><span class="err" aria-live="polite"></span></div>
        <div class="hp" aria-hidden="true"><label for="hi-company">Company</label><input id="hi-company" name="company" type="text" tabindex="-1" autocomplete="off" /></div>
      </div>
      <p class="form-msg" role="alert" hidden></p>
      <button class="send" type="submit"><span class="send-label">Send Message</span><Icon name="arrow-right" /></button>
    </form>
  </div>
  <div class="hi-foot">
    <h3>Say hi !</h3>
    <div class="hi-actions">
      <a href={`tel:${SITE.phoneHref}`}>Buzz me <Icon name="phone" /></a>
      <a href={`mailto:${SITE.email}`}>Ping me <Icon name="mail" /></a>
      <a href={SITE.resume} target="_blank" rel="noopener">Resume <Icon name="file-user" /></a>
    </div>
    <p class="hi-contact-line"><a href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </div>
</aside>

<script>
  const FALLBACK_EMAIL = "senthildevaraj1998@gmail.com";
  const body = document.body;
  const panel = document.getElementById("say-hi");
  const nav = document.querySelector(".nav");
  let lastFocus: HTMLElement | null = null;

  const focusables = () =>
    panel ? [...panel.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),input:not([tabindex="-1"]),textarea')].filter((el) => el.offsetParent !== null) : [];

  function openHi(e?: Event) {
    e?.preventDefault();
    if (!panel) return;
    lastFocus = document.activeElement as HTMLElement | null;
    panel.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => body.classList.add("hi-open", "no-scroll"));
    nav?.classList.remove("open");
    setTimeout(() => panel.querySelector<HTMLElement>("#hi-name")?.focus({ preventScroll: true }), 350);
  }
  function closeHi() {
    if (!panel || !body.classList.contains("hi-open")) return;
    body.classList.remove("hi-open", "no-scroll");
    panel.setAttribute("aria-hidden", "true");
    lastFocus?.focus({ preventScroll: true });
  }
  document.querySelectorAll("[data-say-hi]").forEach((b) => b.addEventListener("click", openHi));
  document.querySelectorAll("[data-close-hi]").forEach((b) => b.addEventListener("click", closeHi));
  document.addEventListener("keydown", (e) => {
    if (!body.classList.contains("hi-open")) return;
    if (e.key === "Escape") closeHi();
    // Keep keyboard focus inside the open panel.
    if (e.key === "Tab") {
      const f = focusables();
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  if (location.hash === "#say-hi") openHi();

  /* ---------- contact form ---------- */
  const form = document.getElementById("hi-form") as HTMLFormElement | null;
  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  if (form) {
    const send = form.querySelector<HTMLButtonElement>(".send")!;
    const msg = form.querySelector<HTMLElement>(".form-msg")!;
    const field = (k: string) => form.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement;
    const rules: Record<string, (v: string) => string> = {
      name: (v) => (v.trim().length >= 2 ? "" : "Enter your name."),
      phone: (v) => {
        const d = v.replace(/[^\d]/g, "");
        return d.length >= 8 && d.length <= 15 ? "" : "Enter a valid mobile number.";
      },
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? "" : "Enter a valid email address."),
      message: (v) => (v.trim().length >= 5 ? "" : "Tell me a little more."),
    };
    const check = (show: boolean) => {
      let ok = true;
      for (const k of Object.keys(rules)) {
        const input = field(k);
        const err = rules[k](input.value);
        if (err) ok = false;
        const wrap = input.closest(".field")!;
        if (show && input.dataset.touched) {
          wrap.classList.toggle("invalid", !!err);
          input.setAttribute("aria-invalid", err ? "true" : "false");
          wrap.querySelector(".err")!.textContent = err;
        }
      }
      send.classList.toggle("ready", ok);
      return ok;
    };
    form.addEventListener("input", () => check(true));
    form.addEventListener("focusout", (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name && rules[t.name]) {
        t.dataset.touched = "1";
        check(true);
      }
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      for (const k of Object.keys(rules)) field(k).dataset.touched = "1";
      if (!check(true)) {
        form.querySelector<HTMLElement>(".field.invalid input, .field.invalid textarea")?.focus();
        return;
      }
      const data = {
        name: field("name").value.trim(),
        phone: field("phone").value.trim(),
        email: field("email").value.trim(),
        message: field("message").value.trim(),
        company: field("company").value,
      };
      send.disabled = true;
      send.classList.add("busy");
      send.querySelector(".send-label")!.textContent = "Sending…";
      msg.hidden = true;
      const first = escapeHtml(data.name.split(" ")[0]);
      const done = () => {
        const box = document.createElement("div");
        box.className = "hi-sent";
        box.setAttribute("role", "status");
        box.innerHTML = (window as any).SITE_PREVIEW
          ? `<h3>Thanks, ${first}!</h3><p>This is the preview, so nothing was sent. On the live site this message goes to Senthil's inbox and you get a reply saying “Thanks, will catch up soon.”</p>`
          : `<h3>Thanks, ${first}!</h3><p>Your message is on its way. I've also sent a note to ${escapeHtml(data.email)}. Will catch up soon.</p>`;
        form.replaceWith(box);
      };
      const fail = (text?: string) => {
        send.disabled = false;
        send.classList.remove("busy");
        send.querySelector(".send-label")!.textContent = "Send Message";
        msg.hidden = false;
        msg.className = "form-msg bad";
        msg.textContent = text || `The message didn't go through. Please try again, or email ${FALLBACK_EMAIL}.`;
      };
      if ((window as any).SITE_PREVIEW) {
        setTimeout(done, 700);
        return;
      }
      fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) })
        .then((r) => r.json().catch(() => ({})).then((j) => (r.ok && j.ok ? done() : fail(j.error))))
        .catch(() => fail());
    });
  }
</script>
